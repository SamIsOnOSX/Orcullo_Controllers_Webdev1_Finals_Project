<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Orcullo Custom Controllers{% endblock %}</title>
    
    <link rel="icon" type="image/png" href="{{ asset('Assets/LogoOnly.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('Assets/LogoOnly.png') }}">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="{{ asset('css/global.css') }}">
    <link rel="stylesheet" href="{{ asset('css/header.css') }}">
    <link rel="stylesheet" href="{{ asset('css/hero.css') }}">
    <link rel="stylesheet" href="{{ asset('css/sections.css') }}">
    <link rel="stylesheet" href="{{ asset('css/footer.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block site_header %}
    <header class="main-header">
        <div class="logo">
            <a href="{{ path('homepage') }}" class="header-logo">
                <img src="{{ asset('Assets/LogoOnly.png') }}" class="logo-image" alt="Orcullo Logo">
                <img src="{{ asset('Assets/TextOnly.png') }}" class="text-logo" alt="Orcullo Custom Controller">
            </a>
        </div>
        
        <nav class="main-nav">
            <a href="{{ path('homepage') }}">Home</a>
            <a href="{{ path('shop') }}">Shop</a>
            <a href="{{ path('customize') }}">Customize</a>
            <a href="{{ path('about') }}">About</a>

            {% if app.user %}
                <a href="{{ path('app_account') }}" class="{{ app.request.attributes.get('_route') == 'app_account' ? 'active' : '' }}">Profile</a>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_dashboard') }}">Admin Panel</a>
            {% elseif is_granted('ROLE_STAFF') %}
                <a href="{{ path('staff_products') }}">Staff Panel</a>
            {% endif %}
        </nav>

        <div class="header-actions">
            <form method="GET" action="{{ path('shop') }}" class="search-bar">
                <input type="text" name="q" value="{{ search_q|default('') }}" placeholder="Search products..." autocomplete="off">
                <button type="submit" class="search-submit" title="Search products" aria-label="Search products">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
            <a href="{{ path('cart') }}" class="icon-link" title="Cart"><i class="fa-solid fa-cart-shopping"></i></a>

            {% if app.user %}
                <a href="{{ path('app_account') }}" class="header-user-badge" title="Go to Profile & Account">
                    <span class="header-user-avatar">{{ app.user.userIdentifier|first|upper }}</span>
                    <span class="header-user-name">{{ app.user.userIdentifier }}</span>
                </a>
                <a href="{{ path('app_logout') }}" class="icon-link header-logout-btn" title="Logout"><i class="fa-solid fa-right-from-bracket"></i></a>
            {% else %}
                <a href="{{ path('app_login') }}" class="header-login-link" title="Login / Register">
                    <i class="fa-regular fa-user"></i>
                    <span>Login</span>
                </a>
            {% endif %}

            <button type="button" class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation menu" aria-expanded="false">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
    </header>
    {% endblock %}

    {% block body %}{% endblock %}

    {% block site_footer %}
    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-column brand-column">
                <div class="footer-logo">
                    <img src="{{ asset('Assets/LogoOnly.png') }}" class="logo-image" alt="Orcullo Logo">
                    <img src="{{ asset('Assets/TextOnly.png') }}" class="text-logo" alt="Orcullo Custom Controller">
                </div>
                <p>Custom gaming controllers designed for players who want greater control and a setup that's uniquely theirs.</p>
            </div>
            
            <div class="footer-column links-column">
                <h4>SHOP</h4>
                <a href="{{ path('shop') }}">Controllers</a>
                <a href="{{ path('customize') }}">Custom Builds</a>
                <a href="{{ path('shop') }}">Accessories</a>
            </div>

            <div class="footer-column links-column support-column">
                <h4>SUPPORT</h4>
                <a href="{{ path('support') }}">Support Center</a>
                <a href="{{ path('support') }}#contact">Contact Us</a>
                <a href="{{ path('support') }}#contact">FAQs</a>
            </div>

            <div class="footer-column newsletter-column">
                <h4>NEWSLETTER</h4>
                <p>Get updates, new designs, and the latest from Orcullo.</p>
                <form class="newsletter-form">
                    <input type="email" placeholder="Email address" required>
                    <button type="submit">JOIN</button>
                </form>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 ALL RIGHTS RESERVED FOR ORCULLO CUSTOM CONTROLLERS.</p>
        </div>
    </footer>
    {% endblock %}
    {% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var toggle = document.getElementById('mobileNavToggle');
            var nav = document.querySelector('.main-nav');
            if (toggle && nav) {
                toggle.addEventListener('click', function() {
                    var isOpen = nav.classList.toggle('is-open');
                    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    var icon = toggle.querySelector('i');
                    if (icon) {
                        icon.className = isOpen ? 'fa-solid fa-xmark' : 'fa-solid fa-bars';
                    }
                });
            }
        });
    </script>
    {% endblock %}
</body>
</html>