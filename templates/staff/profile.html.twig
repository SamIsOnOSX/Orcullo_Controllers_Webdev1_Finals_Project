{% extends 'admin/layout.html.twig' %}

{% block admin_title %}My Profile{% endblock %}

{% block admin_content %}
    <div class="dashboard-page-intro">
        <p class="admin-section-note">
            <i class="fa-solid fa-circle-info"></i>
            Your personal account details. Changes here apply to your own account only.
        </p>
    </div>

    <div class="profile-grid">
        {# ---- Identity card ---- #}
        <div class="dashboard-card profile-identity-card">
            <div class="profile-identity-head">
                <span class="profile-avatar">{{ app.user.username|first|upper }}</span>
                <div>
                    <h3 class="profile-name">{{ app.user.username }}</h3>
                    {% if is_granted('ROLE_ADMIN') %}
                        <span class="user-pwd-role-badge admin-pwd-badge"><i class="fa-solid fa-shield-halved"></i> Admin</span>
                    {% else %}
                        <span class="user-pwd-role-badge staff-pwd-badge"><i class="fa-solid fa-user-gear"></i> Staff</span>
                    {% endif %}
                </div>
            </div>

            <div class="profile-detail-list">
                <div class="profile-detail-row">
                    <span class="profile-detail-label"><i class="fa-solid fa-envelope"></i> Email</span>
                    <span class="profile-detail-value">{{ app.user.email }}</span>
                </div>
                <div class="profile-detail-row">
                    <span class="profile-detail-label"><i class="fa-solid fa-location-dot"></i> Address</span>
                    <span class="profile-detail-value">{{ app.user.address ?: 'No address set' }}</span>
                </div>
                <div class="profile-detail-row">
                    <span class="profile-detail-label"><i class="fa-solid fa-calendar-day"></i> Member since</span>
                    <span class="profile-detail-value">{{ app.user.createdAt ? app.user.createdAt|date('M j, Y') : '—' }}</span>
                </div>
            </div>

            <div class="profile-stat-row">
                <div class="profile-stat">
                    <span class="profile-stat-number">{{ profile_orders }}</span>
                    <span class="profile-stat-label"><i class="fa-solid fa-receipt"></i> Orders placed</span>
                </div>
                <div class="profile-stat">
                    <span class="profile-stat-number">{{ profile_products }}</span>
                    <span class="profile-stat-label"><i class="fa-solid fa-boxes-stacked"></i> Products created</span>
                </div>
            </div>
        </div>

        {# ---- Edit details card ---- #}
        <div class="dashboard-card">
            <h3><i class="fa-solid fa-user-pen card-icon"></i>Edit My Details</h3>
            <form method="POST" action="{{ path('staff_profile') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('staff_profile') }}">
                <input type="hidden" name="form_type" value="details">
                <div class="form-group">
                    <label for="pf_username">Username</label>
                    <input type="text" id="pf_username" name="username" value="{{ app.user.username }}" minlength="3" required>
                </div>
                <div class="form-group">
                    <label for="pf_email">Email</label>
                    <input type="email" id="pf_email" name="email" value="{{ app.user.email }}" required>
                </div>
                <div class="form-group">
                    <label for="pf_address">Address</label>
                    <input type="text" id="pf_address" name="address" value="{{ app.user.address }}" placeholder="No address set">
                </div>
                <button type="submit" class="btn-save-user"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
            </form>
        </div>

        {# ---- Change password card ---- #}
        <div class="dashboard-card">
            <h3><i class="fa-solid fa-key card-icon"></i>Change My Password</h3>
            <p class="admin-section-note"><i class="fa-solid fa-circle-info"></i> Min. 6 characters — takes effect the next time you sign in.</p>
            <form method="POST" action="{{ path('staff_profile') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('staff_profile') }}">
                <input type="hidden" name="form_type" value="password">
                <div class="form-group">
                    <label for="pf_password">New password</label>
                    <div class="pwd-input-wrap">
                        <input type="password" id="pf_password" name="new_password" placeholder="New password (min. 6 chars)" minlength="6" required autocomplete="new-password">
                        <button type="button" class="pwd-toggle-btn" onclick="togglePasswordSibling(this)" aria-label="Toggle password visibility">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn-save-user"><i class="fa-solid fa-floppy-disk"></i> Update Password</button>
            </form>
        </div>
    </div>
{% endblock %}
