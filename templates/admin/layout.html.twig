{% extends 'base.html.twig' %}

{% block title %}{% block admin_title %}Admin Control Center{% endblock %} | Orcullo Custom Controllers{% endblock %}

{# Staff members share this panel shell, but see a reduced, role-aware menu. #}
{% set staff_panel = is_granted('ROLE_STAFF') and not is_granted('ROLE_ADMIN') %}

{# Admin pages render their own full-screen app shell; the storefront chrome is hidden on this section. #}
{% block site_header %}{% endblock %}
{% block site_footer %}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="admin-shell">
    <!-- Fixed Sidebar -->
    <aside class="admin-sidebar">
        <a href="{{ path('homepage') }}" class="admin-sidebar-brand">
            <img src="{{ asset('Assets/LogoOnly.png') }}" class="admin-brand-mark" alt="Orcullo logo">
            <img src="{{ asset('Assets/TextOnly.png') }}" class="admin-brand-text" alt="Orcullo Custom Controllers">
        </a>

        <span class="admin-sidebar-label">{{ staff_panel ? 'Staff Menu' : 'Admin Menu' }}</span>
        <nav class="admin-sidebar-nav">
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_dashboard') }}" class="admin-nav-item {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Overview</span>
            </a>
            {% endif %}
            {% set products_route = staff_panel ? 'staff_products' : 'admin_products' %}
            <a href="{{ path(products_route) }}" class="admin-nav-item {{ app.request.attributes.get('_route') in ['admin_products', 'staff_products', 'staff_edit_product'] ? 'active' : '' }}">
                <i class="fa-solid fa-boxes-stacked"></i>
                <span>Products</span>
            </a>
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_users') }}" class="admin-nav-item {{ app.request.attributes.get('_route') == 'admin_users' ? 'active' : '' }}">
                <i class="fa-solid fa-users"></i>
                <span>Users</span>
            </a>
            <a href="{{ path('admin_orders') }}" class="admin-nav-item {{ app.request.attributes.get('_route') == 'admin_orders' ? 'active' : '' }}">
                <i class="fa-solid fa-receipt"></i>
                <span>Orders</span>
            </a>
            {% endif %}
        </nav>

        <div class="admin-sidebar-footer">
            <span class="admin-sidebar-label">Storefront</span>
            <a href="{{ path('homepage') }}" class="admin-nav-item">
                <i class="fa-solid fa-store"></i>
                <span>View Store</span>
            </a>
            {% if staff_panel %}
            <a href="{{ path('app_account') }}" class="admin-nav-item">
                <i class="fa-solid fa-id-badge"></i>
                <span>My Account</span>
            </a>
            {% endif %}
        </div>
    </aside>

    <!-- Main Area -->
    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-heading">
                <span class="admin-breadcrumb">
                    <a href="{{ staff_panel ? path('staff_products') : path('admin_dashboard') }}">{{ staff_panel ? 'Staff' : 'Admin' }}</a>
                    <i class="fa-solid fa-angle-right"></i>
                    <span>{{ block('admin_title') }}</span>
                </span>
                <h1 class="admin-page-title">{{ block('admin_title') }}</h1>
            </div>
            <div class="admin-topbar-actions">
                <span class="admin-user-chip" title="{{ app.user ? app.user.userIdentifier : 'Admin' }}">
                    <span class="admin-user-avatar">{{ app.user ? app.user.userIdentifier|first|upper : 'A' }}</span>
                    <span class="admin-user-name">{{ app.user ? app.user.userIdentifier : 'Admin' }}</span>
                </span>
                <a href="{{ path('app_logout') }}" class="admin-topbar-icon" title="Log out">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </header>

        <main class="admin-content-area">
            {% for flash in ['admin_message', 'admin_error'] %}
                {% for message in app.flashes(flash) %}
                    <div class="{{ flash == 'admin_message' ? 'alert-success' : 'alert-error' }}">
                        <i class="fa-solid {{ flash == 'admin_message' ? 'fa-circle-check' : 'fa-circle-exclamation' }}"></i>
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}
