<div class="dashboard-card staff-edit-card">
    <h3><i class="fa-solid fa-pen-to-square card-icon"></i>Edit Product: {{ edit_product.name }}</h3>
    <p class="admin-section-note">
        <i class="fa-solid fa-circle-info"></i>
        Admins can edit any record &mdash;
        {% if edit_product.createdBy %}
            currently owned by <strong>{{ edit_product.createdBy.username }}</strong> (staff record).
        {% else %}
            this is a shop-owned record.
        {% endif %}
        Leave the image picker empty to keep the current image. <a href="{{ path('admin_products') }}">Cancel editing</a>.
    </p>
    <form method="POST" action="{{ path('admin_update_product') }}" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_update_product') }}">
        <input type="hidden" name="product_id" value="{{ edit_product.id }}">
        <div class="form-row">
            <div class="form-group flex-2">
                <label for="aedit_prod_name">Product Name *</label>
                <input type="text" id="aedit_prod_name" name="name" value="{{ edit_product.name }}" required>
            </div>
            <div class="form-group flex-1">
                <label for="aedit_prod_price">Price ($) *</label>
                <input type="number" id="aedit_prod_price" name="price" step="0.01" min="0" value="{{ edit_product.price }}" required>
            </div>
            <div class="form-group flex-1">
                <label for="aedit_prod_stock">Stock *</label>
                <input type="number" id="aedit_prod_stock" name="stock" min="0" value="{{ edit_product.stock }}" required>
            </div>
        </div>

        <div class="form-group">
            <label for="aedit_prod_description">Description</label>
            <textarea id="aedit_prod_description" name="description" placeholder="Product features, layout specifications, compatibility...">{{ edit_product.description }}</textarea>
        </div>

        <div class="form-row">
            <div class="form-group flex-1">
                <label for="aedit_product_image"><i class="fa-solid fa-upload label-icon"></i> Replace Image (optional)</label>
                <label class="file-pick-label" title="Choose an image file">
                    <i class="fa-solid fa-paperclip"></i>
                    <span class="file-pick-text">Keep current image</span>
                    <input type="file" id="aedit_product_image" name="product_image" accept=".jpg,.jpeg,.png,.webp,.gif" class="file-pick-input" onchange="this.previousElementSibling.textContent = this.files[0] ? this.files[0].name : 'Keep current image';">
                </label>
            </div>
            <div class="form-group flex-1">
                <label><i class="fa-solid fa-image label-icon"></i> Current Image</label>
                <img src="{{ asset(edit_product.imagePath) }}" alt="{{ edit_product.name }}" class="staff-edit-thumb">
            </div>
        </div>

        <button type="submit" name="update_product" class="btn-primary btn-create-product">
            <i class="fa-solid fa-floppy-disk"></i> Save Changes
        </button>
    </form>
</div>
