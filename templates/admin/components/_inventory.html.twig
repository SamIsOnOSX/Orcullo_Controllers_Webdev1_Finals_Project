<div class="dashboard-card table-responsive">
    <h3><i class="fa-solid fa-boxes-stacked card-icon"></i>Inventory &amp; Stock Management ({{ products|length }})</h3>
    {% include 'admin/components/_table_search.html.twig' with {
        search_action: path('admin_products'),
        search_q: search_q|default(''),
        search_placeholder: 'Search products by name or description…',
    } only %}
    {% if search_q|default('') %}
        <p class="admin-section-note"><i class="fa-solid fa-filter"></i> Showing {{ products|length }} matching product(s) for "{{ search_q }}".</p>
    {% endif %}
    {% if products is empty %}
        <div class="empty-state-box">
            <i class="fa-solid fa-boxes-stacked empty-icon"></i>
            <p class="empty-text">No products found in the catalog.</p>
        </div>
    {% else %}
        <div class="scroll-top-wrapper">
        <table class="order-table">
            <thead>
                <tr>
                    <th class="col-image">Image</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Current Stock</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td>
                            {% if product.imagePath %}
                                <img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}" class="product-thumb-img">
                            {% else %}
                                <div class="product-thumb-placeholder"><i class="fa-solid fa-image"></i></div>
                            {% endif %}
                        </td>
                        <td>
                            <strong>{{ product.name }}</strong>
                            {% if product.description %}
                                <div class="product-desc-preview" title="{{ product.description }}">{{ product.description }}</div>
                            {% endif %}
                        </td>
                        <td><span class="price-cell">${{ product.price|number_format(2) }}</span></td>
                        <td>
                            <form method="POST" action="{{ path('admin_update_stock') }}" class="stock-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_update_stock') }}">
                                <input type="hidden" name="product_id" value="{{ product.id }}">
                                <input type="number" name="new_stock" value="{{ product.stock }}" min="0" class="input-stock">
                                <button type="submit" name="update_stock" class="btn-update-stock">Update</button>
                            </form>
                        </td>
                        <td class="text-right">
                            <form method="POST" action="{{ path('admin_delete_product') }}" class="inline-form" onsubmit="return confirm('Are you sure you want to delete \'{{ product.name|e('js') }}\'?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_product') }}">
                                <input type="hidden" name="product_id" value="{{ product.id }}">
                                <button type="submit" name="delete_product" class="btn-delete">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>{# /.scroll-top-wrapper #}
    {% endif %}
</div>
