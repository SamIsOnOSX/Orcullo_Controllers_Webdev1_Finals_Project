{% extends 'base.html.twig' %}

{% block title %}Shop | Orcullo Custom Controllers{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/shop.css') }}">
{% endblock %}

{% block body %}
<div class="shop-page-wrapper">
    <main class="shop-container">
        <div class="shop-header">
            <h1>Shop</h1>
            <p>High-performance controllers, parts, and accessories.</p>
        </div>

        {% for message in app.flashes('cart_success') %}
            <div class="shop-alert shop-alert--success"><i class="fa-solid fa-circle-check"></i><span>{{ message }}</span></div>
        {% endfor %}
        {% for message in app.flashes('cart_error') %}
            <div class="shop-alert shop-alert--error"><i class="fa-solid fa-circle-exclamation"></i><span>{{ message }}</span></div>
        {% endfor %}

        <!-- Shop toolbar: search + cart shortcut with hover mini-cart -->
        <div class="shop-toolbar">
            <form method="GET" action="{{ path('shop') }}" class="shop-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="shop_search" name="q" value="{{ search_q|default('') }}" placeholder="Search products..." autocomplete="off">
                <button type="submit" class="shop-search-submit" title="Search products" aria-label="Search products">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="shop-cart-wrap">
                <a href="{{ path('cart') }}" class="shop-cart-shortcut">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Your Cart</span>
                    <span class="cart-shortcut-badge">{{ cart_count }}</span>
                </a>

                {# Mini-cart preview — appears on hover/focus of the cart chip #}
                <div class="cart-dropdown">
                    <div class="cart-dropdown-box">
                        <div class="cart-panel-header">
                            <h3><i class="fa-solid fa-cart-shopping"></i> Your Cart <span class="cart-panel-count">{{ cart_count }}</span></h3>
                        </div>

                        {% if cart_items is empty %}
                            <div class="cart-panel-empty">
                                <i class="fa-solid fa-basket-shopping empty-icon"></i>
                                <p class="empty-text">Your cart is empty.</p>
                                <p class="cart-panel-empty-hint">Add controllers from the catalog.</p>
                            </div>
                        {% else %}
                            <ul class="cart-panel-items">
                                {% for item in cart_items %}
                                    <li class="cart-panel-item">
                                        <div class="cart-panel-thumb">
                                            {% if item.imagePath %}
                                                <img src="{{ asset(item.imagePath) }}" alt="{{ item.type }}">
                                            {% else %}
                                                <i class="fa-solid fa-gamepad"></i>
                                            {% endif %}
                                        </div>
                                        <div>
                                            <p class="cart-panel-item-name">{{ item.type }}</p>
                                            <span class="cart-panel-item-meta">Qty {{ item.quantity }} &middot; ${{ (item.price * item.quantity)|number_format(2) }}</span>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>

                            <div class="cart-panel-subtotal">
                                <span>Subtotal</span>
                                <strong>${{ cart_total|number_format(2) }}</strong>
                            </div>
                            <a href="{{ path('cart') }}" class="btn-checkout"><i class="fa-solid fa-lock"></i> Checkout</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if search_q|default('') %}
            <p class="shop-search-note"><i class="fa-solid fa-filter"></i> Showing {{ products|length }} product(s) matching "{{ search_q }}" — <a href="{{ path('shop') }}">clear search</a></p>
        {% endif %}

        <!-- Product Grid -->
        <div class="product-grid" id="product_grid">
            {% if products is empty %}
                <div class="shop-empty-state">
                    <i class="fa-solid fa-box-open empty-icon"></i>
                    {% if search_q|default('') %}
                        <h3>No products match "{{ search_q }}"</h3>
                        <p>Try a different search term or browse the full catalog.</p>
                        <a href="{{ path('shop') }}" class="btn btn-primary">Clear Search</a>
                    {% else %}
                        <h3>No controllers currently in stock</h3>
                        <p>Check back soon or customize your own controller today!</p>
                        <a href="{{ path('customize') }}" class="btn btn-primary">Go to Customizer</a>
                    {% endif %}
                </div>
            {% else %}
                {% for product in products %}
                    {% set stock = product.stock|default(0) %}
                    {% set is_out_of_stock = stock <= 0 %}
                    <div class="product-card {{ is_out_of_stock ? 'out-of-stock' : '' }}">
                        <div class="product-img-wrapper">
                            {% if product.imagePath %}
                                <img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}" class="product-img">
                            {% else %}
                                <div class="product-img-placeholder">
                                    <i class="fa-solid fa-gamepad"></i>
                                </div>
                            {% endif %}

                            {% if is_out_of_stock %}
                                <span class="badge-stock out">Out of Stock</span>
                            {% elseif stock <= 3 %}
                                <span class="badge-stock low">Only {{ stock }} left</span>
                            {% else %}
                                <span class="badge-stock in-stock">In Stock</span>
                            {% endif %}
                        </div>

                        <div class="product-info">
                            <h3 class="product-title">{{ product.name }}</h3>
                            {% if product.description %}
                                <p class="product-description">{{ product.description }}</p>
                            {% endif %}

                            <div class="product-footer">
                                <div class="product-price-row">
                                    <div class="product-price">
                                        <span class="currency">$</span>{{ product.price|number_format(2) }}
                                    </div>
                                    <button type="button" class="btn-wishlist" title="Wishlist coming soon" aria-label="Add {{ product.name }} to wishlist">
                                        <i class="far fa-heart"></i>
                                    </button>
                                </div>

                                <form action="{{ path('cart_add') }}" method="POST" class="product-form">
                                    <input type="hidden" name="product_id" value="{{ product.id }}">
                                    <input type="hidden" name="type" value="{{ product.name }}">
                                    <input type="hidden" name="price" value="{{ product.price }}">
                                    <input type="hidden" name="button_color" value="Standard">
                                    <input type="hidden" name="_token" value="{{ csrf_token('add_to_cart') }}">

                                    <div class="product-action-row">
                                        <div class="quantity-control">
                                            <label for="qty-{{ product.id }}" class="sr-only">Quantity</label>
                                            <input type="number"
                                                   id="qty-{{ product.id }}"
                                                   name="quantity"
                                                   value="1"
                                                   min="1"
                                                   max="{{ max(1, stock) }}"
                                                   class="input-product-qty"
                                                   {{ is_out_of_stock ? 'disabled' : '' }}>
                                        </div>
                                        <button type="submit" name="add_to_cart" value="1" class="add-to-cart-btn" {{ is_out_of_stock ? 'disabled' : '' }}>
                                            <i class="fa-solid fa-cart-plus"></i> {{ is_out_of_stock ? 'Sold Out' : 'Add to Cart' }}
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </main>
</div>

{# Client-side product name filter — frontend only, no backend needed. #}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var search = document.getElementById('shop_search');
        if (!search) { return; }
        search.addEventListener('input', function () {
            var query = search.value.trim().toLowerCase();
            document.querySelectorAll('#product_grid .product-card').forEach(function (card) {
                card.classList.toggle('cart-hidden', query !== '' && !card.textContent.toLowerCase().includes(query));
            });
        });
    });
</script>
{% endblock %}
